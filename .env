# Copy this file to `.env` and fill in the values from your Firebase project:
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDWcWlmUgqjIfElsQoamHMgF-p0PHBjnmk
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=scamsheild-ai-c203a.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=scamsheild-ai-c203a
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=scamsheild-ai-c203a.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=209302813072
EXPO_PUBLIC_FIREBASE_APP_ID=1:209302813072:web:975c9ae6df2a08be061b15

# Google Sign-In
# Firebase Console → Authentication → Sign-in method → Google → enable it.
# That auto-creates a "Web client" OAuth ID in Google Cloud Console
# (APIs & Services → Credentials) — copy it below as the web client id.
# iOS/Android client ids ARE required to test Google Sign-In on those
# platforms (including in Expo Go / dev builds — the web client id only
# works when running in a browser). To get an Android one: Google Cloud
# Console → APIs & Services → Credentials → Create Credentials →
# OAuth client ID → Android, using your app's package name (see app.json
# "android.package") and your debug keystore's SHA-1 fingerprint
# (`keytool -keystore %USERPROFILE%\.android\debug.keystore -list -v`
# on Windows, password "android"). Until this is set, the Google button
# is simply disabled on Android rather than crashing the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=209302813072-j2tic7j0s8pjssiprj78oa0pv466bq4i.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

